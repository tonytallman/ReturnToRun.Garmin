project.manifest = manifest.xml
base.resourcePath = resources;resources-program
# Only source/. The screen tour (tour.jungle) adds source-tour.
base.sourcePath = source
# The vivoactive 3 family's launcher icon is 40 x 33; this folder's LauncherIcon replaces the 40 x 40 one.
vivoactive3.resourcePath = $(vivoactive3.resourcePath);resources-icon-40x33
vivoactive3m.resourcePath = $(vivoactive3m.resourcePath);resources-icon-40x33
vivoactive3mlte.resourcePath = $(vivoactive3mlte.resourcePath);resources-icon-40x33
# fr55, the Legacy Hero First Avenger and Legacy Saga Darth Vader, and the vivoactive 4 use 35 x 35.
fr55.resourcePath = $(fr55.resourcePath);resources-icon-35x35
legacyherofirstavenger.resourcePath = $(legacyherofirstavenger.resourcePath);resources-icon-35x35
legacysagadarthvader.resourcePath = $(legacysagadarthvader.resourcePath);resources-icon-35x35
vivoactive4.resourcePath = $(vivoactive4.resourcePath);resources-icon-35x35
# The Legacy Hero Captain Marvel, Legacy Saga Rey, and vivoactive 4S use 30 x 30.
legacyherocaptainmarvel.resourcePath = $(legacyherocaptainmarvel.resourcePath);resources-icon-30x30
legacysagarey.resourcePath = $(legacysagarey.resourcePath);resources-icon-30x30
vivoactive4s.resourcePath = $(vivoactive4s.resourcePath);resources-icon-30x30
# Watches whose system Menu2 wraps a title such as "Return to Run" onto a second line and cuts it off.
# resources-menu-title turns DrawnMenuTitles on, so their menu titles are drawn on one line (MenuTitle).
vivoactive3.resourcePath = $(vivoactive3.resourcePath);resources-menu-title
vivoactive3m.resourcePath = $(vivoactive3m.resourcePath);resources-menu-title
vivoactive3mlte.resourcePath = $(vivoactive3mlte.resourcePath);resources-menu-title
fr55.resourcePath = $(fr55.resourcePath);resources-menu-title
legacysagadarthvader.resourcePath = $(legacysagadarthvader.resourcePath);resources-menu-title
legacyherofirstavenger.resourcePath = $(legacyherofirstavenger.resourcePath);resources-menu-title
